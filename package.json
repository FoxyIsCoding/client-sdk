{
  "name": "@voidauth/client",
  "version": "1.0.3",
  "description": "VoidAuth OIDC client for browser and Node.js — PKCE, tokens, user info, storage API",
  "type": "module",
  "main": "./dist/core.js",
  "types": "./dist/core.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "voidauth",
    "oidc",
    "oauth",
    "auth",
    "authentication",
    "sso",
    "pkce",
    "jwt",
    "openid-connect"
  ],
  "author": "VoidAuth",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "~5.9.3",
    "@types/node": "^24.12.0"
  }
}
